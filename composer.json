{
  "name": "astrahttp/http",
  "description": "Async PHP HTTP client with browser-grade TLS/HTTP fingerprint control (JA3/JA4), backed by a Go transport. Supports HTTP/2, HTTP/3, streaming, WebSockets and SSE.",
  "keywords": [
    "php",
    "security",
    "astrahttp",
    "cycletls",
    "async",
    "http-client",
    "ja3",
    "fingerprint",
    "scraping",
    "amp",
    "fiber",
    "revolt-php",
    "ja3-fingerprint",
    "crawler"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "amphp/amp": "^3.0",
    "amphp/byte-stream": "^2.1",
    "amphp/websocket-client": "^2.0",
    "revolt/event-loop": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Astra\\Http\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Astra\\Http\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "bin": [
    "bin/astrahttp"
  ],
  "authors": [
    {
      "name": "Ajmal Alkhaledi",
      "email": "ajmalalkhaledi@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
